{
  "name": "life-script-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "assets": "node scripts/generate-assets.mjs && node scripts/generate-favicon.mjs",
    "check": "node --experimental-strip-types scripts/check-chart.ts",
    "verify": "node scripts/verify.mjs",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "start": "node server/index.mjs",
    "preview:prod": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^12.23.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sweph": "^2.10.3-8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
